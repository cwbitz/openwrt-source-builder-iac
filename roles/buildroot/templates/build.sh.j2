#!/bin/bash
set -euo pipefail

# Runs inside the pinned build container (roles/buildroot/files/Dockerfile).
# Everything that does not need the toolchain was prepared on the build host:
# the cached source tree, the feeds, .config, the rendered `files/` overlay and
# the shared dl/ + ccache/ caches. This script owns defconfig, the compile and
# the verification, because those are the steps that need the toolchain.

cd /build
export TMPDIR=/tmp
{% if source.ccache | default(true) | bool %}
export CCACHE_DIR=/ccache
{% endif %}

log() { printf '>>> %s\n' "$*"; }

{% if source.clean | default(false) | bool %}
log "make clean (dl/ and ccache/ are kept)"
make clean
{% endif %}

# defconfig stays serial: the prerequisite checks it triggers build and run their
# test programs under one shared $(TMP_DIR), so parallel jobs clobber each other
# and report the host compilers and tools as broken. The first run on a fresh tree
# can still fail its aggregated prerequisite report spuriously (the same checks
# pass on the immediate retry), so allow one retry — a genuinely missing tool
# fails both attempts.
log "make defconfig"
attempt=1
until make defconfig; do
    if [ "$attempt" -ge 2 ]; then
        echo "ERROR: make defconfig failed on both attempts" >&2
        exit 1
    fi
    echo ">>> retrying make defconfig after a failed first run"
    attempt=$((attempt + 1))
done

# defconfig re-derives the whole config from the dependency graph, so a requested
# kernel option can disappear when its dependency is unmet. Fail here instead of
# shipping a kernel without BTF/ftrace. A `=n` entry is written back by kconfig as
# its `# ... is not set` comment, so that is what gets asserted.
dropped=0
{% for option in source.kernel | default([]) %}
{% if option.endswith('=n') %}
if ! grep -qxF '# {{ option[:-2] }} is not set' .config; then
    printf 'ERROR: dropped by defconfig: %s\n' '{{ option }}' >&2; dropped=1
fi
{% else %}
if ! grep -qxF '{{ option }}' .config; then
    printf 'ERROR: dropped by defconfig: %s\n' '{{ option }}' >&2; dropped=1
fi
{% endif %}
{% endfor %}
[ "$dropped" -eq 0 ] || exit 1

cp -a .config /work/config.final

log "make download"
make -j"${OPENWRT_JOBS}" download

# `world` compiles and installs everything, builds the images (target/install)
# and applies the overlay from <tree>/files, which include/image.mk reads
# directly; the separate `make image` target these refs used to expose no longer
# exists. Only the image-name prefix is passed here: `FILES=` is the kernel-module
# list in include/kernel.mk, and `ROOTFS_PARTSIZE=` overrides the byte value
# image.mk derives from CONFIG_TARGET_ROOTFS_PARTSIZE (which config.j2 sets).
make_args=()
if [ -n "${OPENWRT_EXTRA_FIRMWARE_NAME:-}" ]; then
    make_args+=(EXTRA_IMAGE_NAME="${OPENWRT_EXTRA_FIRMWARE_NAME}")
fi

# `world` builds the host tools in parallel, and some of them do not declare
# their host-tool dependencies (tools/dwarves configures before tools/cmake and
# tools/elfutils are installed), so the first parallel run can fail spuriously.
# Retry once: the second attempt resumes from the finished tools. A real compile
# error fails both attempts.
log "make world"
attempt=1
until make -j"${OPENWRT_JOBS}" world "${make_args[@]}"; do
    if [ "$attempt" -ge 2 ]; then
        echo "ERROR: make world failed on both attempts" >&2
        exit 1
    fi
    echo ">>> retrying make world after a failed first run"
    attempt=$((attempt + 1))
done

log "verify the kernel configuration"
kernel_config=$(find build_dir/target-*/linux-* -maxdepth 2 -type f -name .config | head -n1)
if [ -z "$kernel_config" ]; then
    echo "ERROR: no kernel .config found below build_dir" >&2
    exit 1
fi
{% if source.kernel | default([]) | length > 0 %}
kernel_options=( {% for option in source.kernel %}'{{ option }}' {% endfor %} )
for option in "${kernel_options[@]}"; do
    kernel_option="CONFIG_${option#CONFIG_KERNEL_}"
    if [[ "$option" == *=n ]]; then
        kernel_option="# ${kernel_option%=n} is not set"
    fi
    grep -qxF "$kernel_option" "$kernel_config" \
        || { echo "ERROR: $kernel_option missing from $kernel_config" >&2; exit 1; }
done
{% endif %}

{% if 'CONFIG_KERNEL_DEBUG_INFO_BTF=y' in source.kernel | default([]) %}
log "verify the BTF section"
vmlinux=$(find build_dir -maxdepth 5 -type f -name vmlinux | head -n1)
if [ -z "$vmlinux" ]; then
    echo "ERROR: vmlinux not found; cannot verify BTF" >&2
    exit 1
fi
readelf -S "$vmlinux" | grep -q '\.BTF' \
    || { echo "ERROR: $vmlinux carries no .BTF section" >&2; exit 1; }
{% endif %}

log "verify the removed packages are absent from the image"
manifest=$(find bin/targets -maxdepth 3 -type f -name '*.manifest' | head -n1)
if [ -n "$manifest" ]; then
{% for package in packages_final_list | default([]) | select('match', '^-') %}
    if grep -q '^{{ package[1:] }} ' "$manifest"; then
        echo "ERROR: package removed by the variant is still in the image: {{ package[1:] }}" >&2
        exit 1
    fi
{% endfor %}
else
    echo "WARNING: no .manifest produced; skipped the removed-package check" >&2
fi

log "artifacts"
find bin/targets -maxdepth 3 -type f -printf '%10s  %p\n' | sort -k2
