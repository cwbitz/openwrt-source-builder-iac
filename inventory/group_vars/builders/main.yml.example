---
# ==============================================================================
# Machine-wide operator overrides for the `builders` group
# (inventory/group_vars/builders/main.yml.example)
# ==============================================================================
# Copy to inventory/group_vars/builders/main.yml (`make prep` creates it) to
# change a shared value for every build machine; an empty copy is valid. One
# inventory host = one build machine; its variants live in
# host_vars/<machine>/main.yml (`build_variants`).
#
# This project is designed to COEXIST with openwrt-image-builder-iac on the same
# machine. The system layer (the `iac` account, its sudoers file, SSH keys and
# sshd hardening) is owned by whichever project bootstraps first and must be
# configured identically in both, so every later run converges to a no-op. Set
# create_admin_user=false and sshd_hardening_enabled=false here unless this
# project is the only one managing the machine.

# --- SSH connection identities (non-secret; passwords stay in the machine vault) ---
# Probed in order [iac, admin, root] by `make bootstrap-accounts`;
# build/info connect as `iac`. Each identity takes its password from the machine vault
# and/or a key path here (SSH prefers the key; empty = not used). A pubkey path
# is authorized for that account during bootstrap. The optional human 'admin'
# account exists only while create_admin_user is true: it always gets a
# password (generated into the machine vault when empty) plus any configured key;
# false manages no admin account (least privilege).
create_admin_user: false
admin_username: "admin"
ssh_keys:
  root:
    pubkey: ""
    privkey: ""
  admin:
    pubkey: ""
    privkey: ""
  iac:
    pubkey: ""
    privkey: ""

# --- 'iac' automation account (created by `make bootstrap-accounts`) ----------
# Fixed service uid/gid; project-wide automation accounts use 6000-6499.
iac_uid: 6000
iac_gid: 6000

# --- Host security (role sshd; make build TAGS=sshd) ------------------
# Key-only SSH administration, OFF by default: it closes password login, so it is
# only safe once a keyed login survives it. Root policy is independent.
sshd_hardening_enabled: false
sshd_permit_root_login: "no"
